# Endereço da API do painel (server_app).
VITE_API_URL=http://127.0.0.1:3333

# Atalho de desenvolvimento: entra sem servidor, para dar para construir as
# telas antes da API existir. Só funciona em `npm run dev` — em qualquer build
# o Vite remove esse caminho do bundle. Com ele ligado, o painel mostra uma
# tarja amarela no topo.
VITE_AUTH_FAKE=0
